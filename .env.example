# Trador environment variables
#
# Every variable the code reads, with an empty value. Copy to `.env.local` and
# fill in the ones you need — the app starts without most of them and falls back
# to bundled data, so you can run it locally with only a Solana RPC.
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is public. Everything
# else is server-only and must never be exposed to the client.
#
# Not listed, because the platform injects them: VERCEL, VERCEL_URL,
# VERCEL_GIT_COMMIT_SHA, RAILWAY_ENVIRONMENT, RAILWAY_GIT_COMMIT_SHA.

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------

# Server-only. Quotes, swap simulation and anything that reads an account.
SERVER_RPC_URL=
# Server-only. Fallback for the above, and the first choice for wallet balances.
SOLANA_RPC_URL=
# Server-only. Helius RPC, used for parsed transactions.
HELIUS_RPC_URL=
# Server-only. Helius REST host. Defaults to api-mainnet.helius-rpc.com.
HELIUS_API_URL=
# Server-only. Helius key, when the URL does not already carry one.
HELIUS_API_KEY=
# Server-only. Dedicated RPC for the indexer's getProgramAccounts sweeps.
INDEXER_RPC_URL=
# Server-only. Signature lists for wallet history.
RAW_TX_RPC_URL=
# Read by the browser for live price and trade subscriptions.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=

# ---------------------------------------------------------------------------
# Routing and market data
# ---------------------------------------------------------------------------

# Server-only. Jupiter Swap API key. Without it the v2 endpoints are rate
# limited hard enough to break the order ticket.
JUPITER_API_KEY=
# Server-only. Overrides the Jupiter host. Leave empty for api.jup.ag.
JUPITER_API_URL=
# Server-only. CoinGecko key for stock and SOL prices.
COINGECKO_API_KEY=
# Server-only. Set to "demo" for a demo key; anything else means a pro plan.
COINGECKO_API_PLAN=
# Pools below this much liquidity are hidden from the feeds. Defaults to 500.
NEXT_PUBLIC_MIN_LIQUIDITY_USD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Server-only. Postgres connection string for the app and the worker.
DATABASE_URL=
# Server-only. Alternative name for the same connection string.
POSTGRES_URL=
# Supabase project URL, used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Service role key. Full database access — never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Accounts and sign-in
# ---------------------------------------------------------------------------

# Privy app id. Sign-in and the embedded wallet. Empty means demo mode, which
# can browse but cannot sign.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only. Comma-separated Privy user ids allowed to see admin screens.
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Fees
# ---------------------------------------------------------------------------

# Platform fee in basis points. 50 = half a percent. Empty or 0 means no fee
# anywhere, which is the default.
NEXT_PUBLIC_TRADOR_FEE_BPS=
# Server-only. The wallet fees are collected into. Fees are taken in USDC or
# SOL only, and never charged until this wallet's token accounts exist —
# `npm run fee:accounts` creates them.
TRADOR_FEE_WALLET=

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# Server-only. Upstash Redis for link previews and live reads.
CACHE_KV_REST_API_URL=
CACHE_KV_REST_API_TOKEN=
# Server-only. Older names for the same store, still read as a fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Worker and cron
# ---------------------------------------------------------------------------

# Server-only. Shared secret the cron endpoints check.
CRON_SECRET=
# Server-only. Base URL the cron script calls. Falls back to NEXT_PUBLIC_APP_URL.
CRON_TARGET_URL=
# Server-only. Where the worker posts trades it has picked up.
TRADOR_WEBHOOK_URL=
# Server-only. Verifies Helius webhook deliveries.
HELIUS_WEBHOOK_SECRET=
# Server-only. Worker loop intervals in milliseconds.
INDEX_INTERVAL_MS=
TAPE_INTERVAL_MS=
TRADE_WEBHOOK_INTERVAL_MS=
# Server-only. Milliseconds the indexer waits between RPC calls, to stay under
# the provider's rate limit.
INDEXER_RPC_GAP_MS=
# Server-only. Transactions Helius may parse in one round.
HELIUS_PARSE_MAX_PER_ROUND=
# Server-only. How often the graduating sweep runs, in indexer rounds.
GRADUATING_EVERY=
# Server-only. Set to 0 to stop the worker running these loops.
KEEP_TAPES=
KEEP_TRADE_WEBHOOK=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# Web push keys. The public one is read by the browser; the other two are
# server-only. `npm run vapid` generates a pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Turns on the service worker that receives them.
NEXT_PUBLIC_SERVICE_WORKER=

# ---------------------------------------------------------------------------
# Social
# ---------------------------------------------------------------------------

# Server-only. X API bearer token, for unfurling links in comments.
X_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Presentation
# ---------------------------------------------------------------------------

# Canonical URL, used for share links and absolute image URLs.
NEXT_PUBLIC_APP_URL=
# Set to 1 to frame the app as a phone on desktop.
NEXT_PUBLIC_DESKTOP_PHONE=
# Set to 1 to stream trades over server-sent events instead of polling.
NEXT_PUBLIC_TRADES_SSE=
# Which explorer transaction links point at.
NEXT_PUBLIC_EXPLORER_NAME=
NEXT_PUBLIC_EXPLORER_URL=
