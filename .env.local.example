# Canonical app origin (metadata, OG, share links).
# NEXT_PUBLIC_APP_URL=https://trador.fun

# Privy — the landing page is a Privy login with a Solana embedded wallet.
# Leave unset to run in demo mode (login is faked in this browser).
NEXT_PUBLIC_PRIVY_APP_ID=

# Solana RPC. Everything works on the public endpoint except getProgramAccounts,
# which the indexer and the probe scripts need — public RPCs refuse it. Helius
# also provides the LaserStream subscription the worker uses to see new launches.
# HELIUS_RPC_URL=
# HELIUS_API_KEY=
# SOLANA_RPC_URL=

# Platform fee on swaps, in basis points. Flat 50 bps, collected by Jupiter
# into a token account Trador owns per mint. No on-chain program of our own.
NEXT_PUBLIC_FEE_BPS=50

# Live trading. LIVE_TRADE=1 opens Buy/Sell for every signed-in wallet.
# Leave WALLETS empty for everyone; set it only to restrict to specific keys.
# NEXT_PUBLIC_LIVE_TRADE=1
# NEXT_PUBLIC_FEE_WALLET=
# NEXT_PUBLIC_LIVE_TRADE_WALLETS=

# pump.fun Custom Pairs launching. OFF by default and it should stay off until
# the account layout is verified — see the UNVERIFIED note in src/lib/programs.ts
# and run `npm run probe:pump <mint>` against a known stock-paired pump coin.
# Guessing the quote-mint offset fails silently, which is the worst outcome
# available: the feed looks fine and every Custom Pair is mispriced.
# NEXT_PUBLIC_ENABLE_PUMP_CUSTOM_PAIR=0

# Include Backpack Securities equities (NKE, DKNG, GRND, DJT, RDDT, TTWO…) when
# regenerating the stock registry. Off by default: unlike Backed and PreStocks,
# each Backpack mint has its own mint authority, so membership is a maintained
# per-mint allowlist rather than one key that proves the family.
# INCLUDE_BACKPACK=1

# CoinGecko / GeckoTerminal onchain API, for candles and the trade tape.
# Optional — without it the free endpoint allows roughly 30 calls a minute.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=

# Supabase — the coin universe, profiles, comments, follows, learn progress.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Cron secret for the indexer and price routes.
# CRON_SECRET=

# Never sign a launch or a swap the app has not simulated first. With this set,
# the Create flow builds and simulates but refuses to sign, which is how the
# launch instructions get developed without spending SOL.
# CREATE_DRY_RUN=1

# Shared cache (optional). With these set, a cold instance reads the built feed
# from Redis instead of spending seconds rebuilding it.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
