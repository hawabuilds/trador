# Every variable Trador actually reads. Nothing here is required — the app runs
# with an empty file, on a captured snapshot and free provider tiers.
#
# There is no database. The snapshot in src/lib/server/snapshot.generated.json
# is the store, so there are no migrations to run and no SQL to apply.

# ---------------------------------------------------------------------------
# Sign-in and signing
# ---------------------------------------------------------------------------

# Privy app id. Without it the session is a demo that cannot sign, so Buy/Sell
# and Create are visible but refuse rather than faking a result.
#
# Whichever domains you serve from must be listed as allowed origins in the
# Privy dashboard, or login fails with no error in the UI.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# Chain access (split URLs so one Alchemy key is not billed for everything)
# ---------------------------------------------------------------------------

# App server (Vercel): wallet proxy, launch confirm, holdings, registration.
# Prefer SERVER_RPC_URL; HELIUS_RPC_URL is an alias. Do not set SOLANA_RPC_URL
# unless you still use Alchemy — it is last in the chain and easy to forget.
# SERVER_RPC_URL=
# HELIUS_RPC_URL=

# Indexer worker (Railway) only: discovery sweeps (getProgramAccountsV2 on
# Helius; ~1 credit/page vs ~10 for classic GPA). Unset on Vercel so a cold
# serverless start never runs a full reconcile unless cron fills in.
# INDEXER_RPC_URL=
# HELIUS_RPC_URL=          # same host as above is fine on the worker

# Signature lists and raw getTransaction batches (worker tapes). Free mainnet
# is the default in code; set explicitly on Railway if you want it documented.
# RAW_TX_RPC_URL=https://api.mainnet-beta.solana.com

# Legacy single URL — avoid for production; scripts and old paths still read it.
# SOLANA_RPC_URL=

# Optional: browser talks straight to a domain-restricted key instead of /api/rpc.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------

# CoinGecko / GeckoTerminal, for candles and the trade tape. Without a key the
# free tier allows roughly 30 calls a minute and the tape refreshes every 12s
# instead of every 4s. Set COINGECKO_API_PLAN=demo for a Demo key; paid keys
# need no plan setting.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=

# Jupiter. The free lite endpoint is the default; set this to a paid host if you
# have one.
# JUPITER_API_URL=https://lite-api.jup.ag

# ---------------------------------------------------------------------------
# Fees
# ---------------------------------------------------------------------------

# Platform fee in basis points. 50 = half a percent.
NEXT_PUBLIC_FEE_BPS=50

# Where the fee lands. **Until this is set, no fee is charged at all** — the
# router is only asked for one when there is an account to receive it, and the
# order ticket says "None" rather than claiming a cut it never priced.
#
# It must be a token account whose mint is one side of the swap, not a plain
# wallet, and one is needed per mint you want to collect in.
# NEXT_PUBLIC_FEE_WALLET=

# ---------------------------------------------------------------------------
# Presentation
# ---------------------------------------------------------------------------

# Canonical origin for metadata and share links. Falls back to VERCEL_URL.
# NEXT_PUBLIC_APP_URL=https://trador.fun

# Desktop phone stage. Off unless set, so trador.one keeps its current frame.
# A separate deployment sets this to 1 and shows the app inside an iPhone.
# NEXT_PUBLIC_DESKTOP_PHONE=1

# Block explorer for the links on an asset page.
# NEXT_PUBLIC_EXPLORER_URL=https://solscan.io
# NEXT_PUBLIC_EXPLORER_NAME=Solscan

# The liquidity floor below which a coin is marked untradeable. Unmeasured
# liquidity stays null and still shows — see the three-state rule.
# NEXT_PUBLIC_MIN_LIQUIDITY_USD=500

# ---------------------------------------------------------------------------
# Script-only
# ---------------------------------------------------------------------------

# Admit Backpack Securities equities when regenerating the stock registry. Off
# by default: unlike Backed and PreStocks, each Backpack mint has its own mint
# authority, so membership is a maintained allowlist rather than one key that
# proves the family.
# INCLUDE_BACKPACK=1

# ---------------------------------------------------------------------------
# Performance experiments (optional)
# ---------------------------------------------------------------------------

# Live trade tape over SSE on coin pages; polling remains the default.
# NEXT_PUBLIC_TRADES_SSE=1

# Register public/sw.js for bootstrap + brand asset caching.
# NEXT_PUBLIC_SERVICE_WORKER=1
